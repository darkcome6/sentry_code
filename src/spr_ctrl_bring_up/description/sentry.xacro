<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sentry">
    <xacro:include filename="$(find spr_sentry_description)/sentry.urdf.xacro" />
    <ros2_control name="SprHardwareInterface" type="system">
        <!-- <hardware>
            <plugin>spr_hw_interface/SprHardwareInterface</plugin>
            <param name="can_device_count_">2</param>
         </hardware> -->
        <hardware>
            <!-- 无真机时用 effort 模拟硬件调试位置环->effort 链路 -->
            <plugin>spr_hw_interface/EffortMockSystem</plugin>
            <param name="accel_per_effort">0.5</param>
        </hardware>
<!--
std::string motor_name;
  std::string can_bus;
  uint32_t tx_id;
  uint32_t rx_id;
  uint32_t identifier;//报文标识符
  uint16_t offset;//电机编码器零点偏移
  Motor_Type_e motor_type;

  typedef enum
    {
        MOTOR_TYPE_NONE = 0,
        DM6006,
        DM4310,
        GM6020,
        M3508,
        M2006,
        VIRTUAL_JOINT,
    } Motor_Type_e;-->
        <joint name="bigyaw_joint">
            <param name="motor_name">bigyaw_motor</param>
            <param name="can_bus">can0</param>
            <param name="tx_id">1</param>
            <param name="offset">0</param>
            <param name="motor_type">DM6006</param>
            <param name="pos_max">12.5</param>
            <param name="vel_max">30</param>
            <param name="tor_max">10</param>
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort" />
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="small_yaw_joint">
            <param name="motor_name">small_yaw_motor</param>
            <param name="can_bus">can0</param>
            <param name="tx_id">2</param>
            <param name="offset">0</param>
            <param name="motor_type">GM6020</param>
            <command_interface name="effort" />
            <command_interface name="position"/>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="pitch_joint">
            <param name="motor_name">pitch_motor</param>
            <param name="can_bus">can0</param>
            <param name="tx_id">3</param>
            <param name="offset">0</param>
            <param name="motor_type">DM4310</param>
            <param name="pos_max">12.5</param>
            <param name="vel_max">30</param>
            <param name="tor_max">10</param>
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort" />
            <state_interface name="position" />
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="left_wheel_front_joint">
            <param name="motor_name">left_wheel_front_motor</param>
            <param name="can_bus">can1</param>
            <param name="tx_id">1</param>
            <param name="offset">0</param>
            <param name="motor_type">M3508</param>
            <command_interface name="effort" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="right_wheel_front_joint">
            <param name="motor_name">right_wheel_front_motor</param>
            <param name="can_bus">can1</param>
            <param name="tx_id">2</param>
            <param name="offset">0</param>
            <param name="motor_type">M3508</param>
            <command_interface name="effort" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="left_wheel_back_joint">
            <param name="motor_name">left_wheel_back_motor</param>
            <param name="can_bus">can1</param>
            <param name="tx_id">3</param>
            <param name="offset">0</param>
            <param name="motor_type">M3508</param>
            <command_interface name="effort" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="right_wheel_back_joint">
            <param name="motor_name">right_wheel_back_motor</param>
            <param name="can_bus">can1</param>
            <param name="tx_id">4</param>
            <param name="offset">0</param>
            <param name="motor_type">M3508</param>
            <command_interface name="effort" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
    </ros2_control>
</robot>
    