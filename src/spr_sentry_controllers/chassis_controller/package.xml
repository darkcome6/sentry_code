<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>chassis_controller</name>
  <version>0.0.0</version>
  <description>Mecanum wheel chassis speed controller (velocity loop -> effort current)</description>
  <maintainer email="2786573564@qq.com">b</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>controller_interface</depend>
  <depend>control_toolbox</depend>
  <depend>realtime_tools</depend>
  <depend>generate_parameter_library</depend>
  <depend>pluginlib</depend>
  <depend>geometry_msgs</depend>
  <depend>spr_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <controller_interface plugin="${prefix}/chassis_controller.xml"/>
  </export>
</package>
