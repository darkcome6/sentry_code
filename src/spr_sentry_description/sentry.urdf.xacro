<?xml version="1.0" encoding="utf-8"?>
<robot name="sentry">
  <link name="odom"/>
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <material name="">
        <color rgba="1 0 0 1" />
      </material>
      <geometry>
        <box size="0.5 0.5 0.1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.5 0.5 0.1" />
      </geometry>
    </collision>
  </link>
  <joint name="base_joint" type="fixed">
    <origin xyz="0 0 0.15" rpy="0 0 0" />
    <parent link="odom" />
    <child link="base_link" />
    <axis xyz="0 0 0" />
  </joint>
  <link name="bigyaw_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <material name="">
        <color rgba="0 1 1 1" />
      </material>
      <geometry>
        <cylinder radius="0.2" length="0.1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.2" length="0.1" />
      </geometry>
    </collision>
  </link>
  <joint name="bigyaw_joint" type="continuous">
      <origin xyz="0 0 0.1" rpy="0 0 0" />
      <parent link="base_link" />
      <child link="bigyaw_link" />
      <axis xyz="0 0 1" />
  </joint>
  <link name="small_yaw_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <material name="">
        <color rgba="0 0 1 1" />
      </material>
      <geometry>
        <cylinder radius="0.03" length="0.3" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.03" length="0.3" />
      </geometry>
    </collision>
  </link>
  <joint name="small_yaw_joint" type="continuous">
    <origin xyz="0 0 0.1" rpy="0 0 0" />
    <parent link="bigyaw_link" />
    <child link="small_yaw_link" />
    <axis xyz="0 0 1" />
  </joint>
  <link name="pitch_link">
    <visual>
      <origin xyz="0.14 0 0" rpy="0 1.5708 0" />
      <material name="">
        <color rgba="0 1 1 1" />
      </material>
      <geometry>
        <cylinder radius="0.05" length="0.28" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.14 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.05" length="0.28" />
      </geometry>
    </collision>
  </link>
  <joint name="pitch_joint" type="continuous">
    <origin xyz="0 0 0.15" rpy="0 0 0" />
    <parent link="small_yaw_link" />
    <child link="pitch_link" />
    <axis xyz="0 1 0" />
  </joint>
  <link name="left_wheel_front_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <material name="">
        <color rgba="1 1 0 1" />
      </material>
      <geometry>
        <cylinder radius="0.1" length="0.1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.1" />
      </geometry>
    </collision>
  </link>
  <joint name="left_wheel_front_joint" type="continuous">
    <origin xyz="-0.2 0.25 -0.05" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="left_wheel_front_link" />
    <axis xyz="0 1 0" />
  </joint>
  <link name="right_wheel_front_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <material name="">
        <color rgba="1 1 0 1" />
      </material>
      <geometry>
        <cylinder radius="0.1" length="0.1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.1" />
      </geometry>
    </collision>
  </link>
  <joint name="right_wheel_front_joint" type="continuous">
    <origin xyz="-0.2 -0.25 -0.05" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="right_wheel_front_link" />
    <axis xyz="0 1 0" />
  </joint>
  <link name="left_wheel_back_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <material name="">
        <color rgba="1 1 0 1" />
      </material>
      <geometry>
        <cylinder radius="0.1" length="0.1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.1" />
      </geometry>
    </collision>
    </link>
    <joint name="left_wheel_back_joint" type="continuous">
      <origin xyz="0.2 0.25 -0.05" rpy="0 0 0" />
      <parent link="base_link" />
      <child link="left_wheel_back_link" />
      <axis xyz="0 1 0" />
    </joint>
    <link name="right_wheel_back_link">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
            <material name="">
            <color rgba="1 1 0 1" />
            </material>
            <geometry>
                <cylinder radius="0.1" length="0.1" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
