<?xml version="1.0" encoding="utf-8"?>
<!--
  jump.xml —— 飞坡场景
  平地 + 起跳台（约 21° 陡坡）+ 落点平台。
  机器人加速冲上起跳台后腾空，测试着落/稳定性。
  调 kicker 的 euler（0.4）和 landing 的位置/高度可改变跳远/跳高。
-->
<mujoco model="sentry_scene_jump">
  <include file="../sentry_robot.xml"/>

  <statistic center="0 0 0.3" extent="2.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="6 6 0.1" material="groundplane" rgba="0.6 0.6 0.6 1"/>
    <!-- 起跳台：3m 长，绕 y 倾斜 0.4 rad(~21°)，低端 x≈2 高端 x≈5 -->
    <geom name="kicker" type="box" size="1.5 1.5 0.05" pos="3.5 0 0.58" euler="0 0.4 0" rgba="0.6 0.4 0.3 1"/>
    <!-- 落点平台：调整 pos 控制落地距离/高度 -->
    <geom name="landing" type="box" size="1 2 0.5" pos="8 0 0.5" rgba="0.4 0.4 0.5 1"/>
  </worldbody>
</mujoco>
